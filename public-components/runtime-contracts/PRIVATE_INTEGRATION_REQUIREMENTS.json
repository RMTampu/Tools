    "privateHostOwnsTrustManifest": true,
    "publicMustNotKnowPrivateInputList": true
  },
  "forbiddenAssumptions": [
    "promotion package automatically updates host dependency trust state",
    "public repository may inspect or modify private trust inputs",
    "stale host dependency evidence may be reused after integration input changes"
  ]
